# All secrets and site-specific settings for the IOC triage agent.
# Copy to .env (gitignored) and fill in:   cp .env.example .env
# Variables already set in the shell take precedence over this file.
# Text after " #" is a comment; quote a value that contains " #" (e.g. a password).

# --- ClickHouse (SuperNetFlow), required ------------------------------------
CLICKHOUSE_HOST=clickhouse.example.org
CLICKHOUSE_USER=your-username
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_PORT=8123

# --- LLM provider: "ollama" (default) or "openrouter" -----------------------
LLM_PROVIDER=ollama

# Ollama. The key is only needed for Ollama Cloud or a remote server behind
# auth; leave it empty for a local `ollama serve`.
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_API_KEY=
# Recommended model; use qwen2.5:7b on machines with less memory.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768
# Thinking mode (qwen3.5): 0 = off (faster), 1 = on. Remove this line for qwen2.5, which has none.
OLLAMA_THINK=0

# OpenRouter (only when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Organisation (used in prompts and reports only) -------------------------
# ORG_NAME=Example University

# Local time zone (IANA name). Data stays UTC; case files add local times.
# LOCAL_TIMEZONE=Australia/Sydney
# Background on the site given to the model, on one line.
# SITE_CONTEXT=A large university. Hosts include student residences, staff and research networks, and teaching labs.

# --- Host classification (python -m host_classification) --------------------
# Campus address range used to pick hosts for the per-type profiles.
# CAMPUS_CIDR=192.0.2.0/24
# HOST_TYPE_WINDOW_DAYS=7    # days of the case host's traffic used to classify it

# --- IOC feed ----------------------------------------------------------------
# Feed field holding the internal host's IP, if your feed doesn't call it
# "affected_asset".
# FEED_ASSET_FIELD=affected_asset

# REVERSE_DNS=1             # host names in reports via reverse DNS (0 to turn off)

# --- Optional agent overrides ---------------------------------------------------
# MAX_TOOL_ROUNDS=12         # model tool rounds per case (queries and charts)
# MODEL_REFINE_ROUNDS=1      # self-check passes on the model's report (0 = off)
# MAX_TOKENS=8000            # reply budget: the model writes the whole report
# LLM_TIMEOUT_SEC=900        # seconds to wait for one model reply
# NAMES_WINDOW_MINUTES=10    # names near each feed match
# CAMPUS_LOOKUP_DAYS=5       # campus-wide passive DNS / popularity window (max 5)

# --- Optional time-window overrides (days) ----------------------------------
# FLOW_LOOKBACK_DAYS=90
# FLOW_LOOKAHEAD_DAYS=14
# ACTIVITY_RETENTION_DAYS=16
# ACTIVITY_CHUNK_DAYS=5
# PEER_LOOKBACK_DAYS=60
